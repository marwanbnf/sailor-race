  "components": [
    {
      "name": "Ship Tag",
      "kind": "chip",
      "refersTo": "ship-tag",
      "description": "Class-colour pill under each dhow: name in Baloo, raw points in a nested ink pill.",
      "html": "<div dir=\"rtl\" style=\"background:#1a9cc2;padding:24px;display:flex;gap:16px\"><span class=\"ds-tag\" style=\"background:#EF4444\">فصل 2 <b>4,600</b></span><span class=\"ds-tag\" style=\"background:#8B5CF6\">فصل 4 <b>2,700</b></span></div>",
      "css": ":host{--sea-shallow:#46cfd9;--ink:#062a3b;--ink-2:#0a3a50;--gold:#ffd25c;--gold-hot:#ffb627;--sand:#f2d28b;--paper:#fff8e8;--coral:#ff5d4f;--ease-out:cubic-bezier(0.16,1,0.3,1);--font-display:\"Baloo Bhaijaan 2\",\"Tajawal\",sans-serif;--font-body:\"Tajawal\",sans-serif;} .ds-tag{display:inline-flex;align-items:center;gap:0.35em;padding:0.1em 0.6em 0.16em;border-radius:999px;color:#fff;font-family:var(--font-display);font-weight:800;font-size:19px;line-height:1.15;white-space:nowrap;box-shadow:0 3px 8px rgba(0,0,0,0.32),0 10px 20px rgba(3,30,55,0.4);text-shadow:0 1px 0 rgba(0,0,0,0.25)}.ds-tag b{font-family:var(--font-body);font-weight:900;font-variant-numeric:tabular-nums;padding:0 0.4em;border-radius:999px;background:rgba(6,42,59,0.55);color:var(--gold);font-size:0.86em}"
    },
    {
      "name": "Channel Buoy",
      "kind": "custom",
      "refersTo": "buoy-value",
      "description": "Coral buoy with numeral and lamp; value pill turns gold once the leader passes.",
      "html": "<div style=\"background:#0b6e88;padding:24px;display:flex;gap:32px\"><div class=\"ds-buoy\"><svg width=\"72\" height=\"94\" viewBox=\"0 0 40 52\"><ellipse cx=\"20\" cy=\"46\" rx=\"17\" ry=\"4\" fill=\"rgba(244,255,253,0.5)\"/><path d=\"M20 9 L20 17 M14 17 L26 17\" stroke=\"#16323f\" stroke-width=\"2.2\" stroke-linecap=\"round\"/><circle cx=\"20\" cy=\"6\" r=\"4\" fill=\"#5d7480\" stroke=\"#16323f\" stroke-width=\"1.6\"/><path d=\"M7 27 Q7 17 20 17 Q33 17 33 27 L34 41 Q20 48 6 41 Z\" fill=\"#ff5d4f\" stroke=\"#5a1410\" stroke-width=\"1.8\" stroke-linejoin=\"round\"/><path d=\"M6.6 26 L33.4 26 L33.9 37 Q20 41 6.1 37 Z\" fill=\"#fff8e8\"/><text x=\"20\" y=\"35.2\" text-anchor=\"middle\" font-size=\"13.5\" font-weight=\"900\" font-family=\"Tajawal, sans-serif\" fill=\"#062a3b\">10</text></svg><span class=\"ds-buoy-value\">5,000</span></div><div class=\"ds-buoy ds-buoy--lit\"><svg width=\"72\" height=\"94\" viewBox=\"0 0 40 52\"><ellipse cx=\"20\" cy=\"46\" rx=\"17\" ry=\"4\" fill=\"rgba(244,255,253,0.5)\"/><circle cx=\"20\" cy=\"6\" r=\"9\" fill=\"rgba(255,210,92,0.55)\"/><path d=\"M20 9 L20 17 M14 17 L26 17\" stroke=\"#16323f\" stroke-width=\"2.2\" stroke-linecap=\"round\"/><circle cx=\"20\" cy=\"6\" r=\"4\" fill=\"#ffd25c\" stroke=\"#16323f\" stroke-width=\"1.6\"/><path d=\"M7 27 Q7 17 20 17 Q33 17 33 27 L34 41 Q20 48 6 41 Z\" fill=\"#ff5d4f\" stroke=\"#5a1410\" stroke-width=\"1.8\" stroke-linejoin=\"round\"/><path d=\"M6.6 26 L33.4 26 L33.9 37 Q20 41 6.1 37 Z\" fill=\"#fff8e8\"/><text x=\"20\" y=\"35.2\" text-anchor=\"middle\" font-size=\"13.5\" font-weight=\"900\" font-family=\"Tajawal, sans-serif\" fill=\"#062a3b\">3</text></svg><span class=\"ds-buoy-value\">1,500</span></div></div>",
      "css": ":host{--sea-shallow:#46cfd9;--ink:#062a3b;--ink-2:#0a3a50;--gold:#ffd25c;--gold-hot:#ffb627;--sand:#f2d28b;--paper:#fff8e8;--coral:#ff5d4f;--ease-out:cubic-bezier(0.16,1,0.3,1);--font-display:\"Baloo Bhaijaan 2\",\"Tajawal\",sans-serif;--font-body:\"Tajawal\",sans-serif;} .ds-buoy{display:flex;flex-direction:column;align-items:center}.ds-buoy-value{margin-top:2px;padding:0.05em 0.55em 0.1em;border-radius:999px;background:rgba(6,42,59,0.78);color:var(--sand);font-family:var(--font-body);font-weight:800;font-size:23px;font-variant-numeric:tabular-nums;line-height:1.25;box-shadow:0 3px 8px rgba(3,30,55,0.35);transition:opacity 300ms ease}.ds-buoy--lit .ds-buoy-value{background:var(--gold);color:var(--ink)}"
    },
