      "html": "<div dir=\"rtl\" style=\"background:#46cfd9;padding:24px\"><div class=\"ds-plate\">جزيرة التحدي<small><svg width=\"18\" height=\"18\" viewBox=\"0 0 20 20\"><circle cx=\"10\" cy=\"10\" r=\"8.5\" fill=\"#f5b32a\" stroke=\"#9a6410\" stroke-width=\"1.5\"/><circle cx=\"10\" cy=\"10\" r=\"5.2\" fill=\"none\" stroke=\"#fff0b8\" stroke-width=\"1.4\" opacity=\"0.85\"/></svg>2,000</small></div></div>",
      "css": ":host{--sea-shallow:#46cfd9;--ink:#062a3b;--ink-2:#0a3a50;--gold:#ffd25c;--gold-hot:#ffb627;--sand:#f2d28b;--paper:#fff8e8;--coral:#ff5d4f;--ease-out:cubic-bezier(0.16,1,0.3,1);--font-display:\"Baloo Bhaijaan 2\",\"Tajawal\",sans-serif;--font-body:\"Tajawal\",sans-serif;} .ds-plate{display:inline-block;padding:0.18em 0.85em 0.22em;border-radius:999px;background:linear-gradient(180deg,#fff3cf,var(--sand));color:var(--ink);font-family:var(--font-display);font-weight:800;font-size:24px;line-height:1.1;text-align:center;box-shadow:0 3px 6px rgba(120,80,20,0.45),0 12px 22px rgba(3,30,55,0.38)}.ds-plate small{display:flex;align-items:center;justify-content:center;gap:0.3em;font-family:var(--font-body);font-weight:900;font-size:0.86em;color:#6b4a14;font-variant-numeric:tabular-nums}"
