/**
 * تقرير ولي الأمر الأسبوعي — نسخة تجريبية مستقلة
 *
 * طريقة التجربة:
 * 1) أنشئ ملفاً جديداً داخل Apps Script باسم ParentReport.gs
 * 2) الصق هذا الملف كما هو.
 * 3) شغّل الدالة createTestParentReportForAli مرة واحدة.
 *
 * لا يعدّل هذا الملف Code.gs ولا يؤثر على التسجيل أو تقارير الحلقات.
 */

const PR_TEST_STUDENT_NAME = 'علي عامر';
const PR_TEST_TEAM_ID = 'purple';
const PR_TEST_WEEK_NUMBER = 2;
const PR_TEST_TEACHER_NAME = 'محمد سندابي';
const PR_REPORTS_FOLDER_NAME = 'تقارير أولياء الأمور';

// شعار ربيع القلوب المرسل من المستخدم، مضمّن داخل الملف حتى لا يحتاج رابطاً خارجياً.
const PR_LOGO_PNG_BASE64 = '';

function createTestParentReportForAli() {
  return createParentWeeklyReport({
    studentName: PR_TEST_STUDENT_NAME,
    teamId: PR_TEST_TEAM_ID,
    weekNumber: PR_TEST_WEEK_NUMBER,
    teacherName: PR_TEST_TEACHER_NAME,
  });
}

/**
 * ينشئ ورقة تقرير مصممة داخل نفس ملف Google Sheets ثم يصدرها PDF إلى Drive.
 */
function createParentWeeklyReport(options) {
  options = options || {};
  const studentName = String(options.studentName || '').trim();
  const teamId = prNormalizeTeamId_(options.teamId || '');
  const weekNumber = Math.max(1, Number(options.weekNumber || 1));
  const teacherName = String(options.teacherName || 'محمد سندابي').trim();

  if (!studentName) throw new Error('اسم الطالب مطلوب');
  if (!teamId) throw new Error('الحلقة غير صحيحة');

  const ss = SpreadsheetApp.openById(SPREADSHEET_ID);
  const reportData = prBuildWeeklyStudentData_(ss, studentName, teamId, weekNumber, teacherName);
  const sheet = prBuildReportSheet_(ss, reportData);
  SpreadsheetApp.flush();
  Utilities.sleep(1200);

  const pdfFile = prExportReportSheetAsPdf_(ss, sheet, reportData);
  ss.setActiveSheet(sheet);
  ss.toast('تم إنشاء تقرير ' + studentName + ' وحفظ نسخة PDF في Google Drive', 'تقرير ولي الأمر', 8);

  const result = {
    ok: true,
    studentName: studentName,
    weekNumber: weekNumber,
    reportSheetName: sheet.getName(),
    spreadsheetUrl: ss.getUrl() + '#gid=' + sheet.getSheetId(),
    pdfName: pdfFile.getName(),
    pdfUrl: pdfFile.getUrl(),
  };

  Logger.log(JSON.stringify(result, null, 2));
  Logger.log('رابط ورقة التقرير: ' + result.spreadsheetUrl);
  Logger.log('رابط PDF: ' + result.pdfUrl);
  return result;
}

function prBuildWeeklyStudentData_(ss, studentName, teamId, weekNumber, teacherName) {
  const logSheet = ss.getSheetByName(SHEET_LOG || 'البيانات');
  if (!logSheet) throw new Error('لم يتم العثور على ورقة البيانات');

  const courseStart = prParseDate_(COURSE_START_DATE || '2026-07-05');
  if (!courseStart) throw new Error('تاريخ بداية الدورة غير صحيح');

  const weekDates = prGetWeekDates_(courseStart, weekNumber);
  if (!weekDates.length) throw new Error('لا توجد أيام محسوبة لهذا الأسبوع');

  const targetStudent = prNormalizeName_(studentName);
  const lastRow = logSheet.getLastRow();
  const byDate = {};

  if (lastRow >= 2) {
    const rows = logSheet.getRange(2, 1, lastRow - 1, Math.max(14, COL.TEAM || 14)).getValues();
    rows.forEach(function(row) {
      const rowStudent = prNormalizeName_(row[(COL.STUDENT || 2) - 1]);
      if (!rowStudent || rowStudent !== targetStudent) return;

      const rowTeam = prNormalizeTeamId_(row[(COL.TEAM || 14) - 1]);
      if (rowTeam && rowTeam !== teamId) return;

      const dateStr = prNormalizeDate_(prDateCellToString_(row[(COL.DATE || 1) - 1]));
      if (!dateStr) return;

      byDate[dateStr] = {
        date: dateStr,
        hudur: prAttendanceText_(row[(COL.HUDUR || 3) - 1]),
        hifzFrom: String(row[(COL.HIFZ_FROM || 4) - 1] || '').trim(),
        hifzTo: String(row[(COL.HIFZ_TO || 5) - 1] || '').trim(),
        hifzScore: prScoreNumber_(row[(COL.HIFZ_SCORE || 6) - 1]),
        muraFrom: String(row[(COL.MURA_FROM || 7) - 1] || '').trim(),
        muraTo: String(row[(COL.MURA_TO || 8) - 1] || '').trim(),
        muraScore: prScoreNumber_(row[(COL.MURA_SCORE || 9) - 1]),
        haqiba: prYesNoText_(row[(COL.HAQIBA || 10) - 1]),
        istima: prYesNoText_(row[(COL.ISTIMA || 11) - 1]),
        total: prNumber_(row[(COL.TOTAL || 12) - 1]),
        note: String(row[(COL.NOTE || 13) - 1] || '').trim(),
      };
    });
  }

  const days = weekDates.map(function(dateObj) {
    const key = prNormalizeDate_(prFormatDate_(dateObj));
    const record = byDate[key] || {};
    return {
      dateObj: dateObj,
      date: key,
      dayName: prDayName_(dateObj),
      hudur: record.hudur || '—',
      hifzFrom: record.hifzFrom || '',
      hifzTo: record.hifzTo || '',
      hifzScore: prNumber_(record.hifzScore),
      muraFrom: record.muraFrom || '',
      muraTo: record.muraTo || '',
      muraScore: prNumber_(record.muraScore),
      haqiba: record.haqiba || '—',
      istima: record.istima || '—',
      total: prNumber_(record.total),
      note: record.note || '',
      hasRecord: !!byDate[key],
    };
  });

  const dayCount = days.length;
  const presentCount = days.filter(function(d) { return d.hudur === 'حاضر'; }).length;
  const hifzTotal = days.reduce(function(sum, d) { return sum + d.hifzScore; }, 0);
  const muraTotal = days.reduce(function(sum, d) { return sum + d.muraScore; }, 0);
  const bagCount = days.filter(function(d) { return d.haqiba === 'نعم'; }).length;
  const listeningCount = days.filter(function(d) { return d.istima === 'نعم'; }).length;
  const pointsTotal = days.reduce(function(sum, d) { return sum + d.total; }, 0);
  const target = dayCount * 100;

  const metrics = {
    attendance: prPct_(presentCount, dayCount),
    hifz: prPct_(hifzTotal, dayCount * 30),
    review: prPct_(muraTotal, dayCount * 30),
    bag: prPct_(bagCount, dayCount),
    listening: prPct_(listeningCount, dayCount),
    overall: prPct_(pointsTotal, target),
  };

  const feedback = prBuildFeedback_(metrics);
  const teamName = (typeof TEAM_SHEETS !== 'undefined' && TEAM_SHEETS[teamId]) || prTeamName_(teamId);
  const startDate = days[0].dateObj;
  const endDate = days[days.length - 1].dateObj;

  return {
    studentName: studentName,
    teacherName: teacherName,
    teamId: teamId,
    teamName: teamName,
    weekNumber: weekNumber,
    weekLabel: 'الأسبوع ' + prArabicOrdinal_(weekNumber),
    dateRange: 'من ' + prFormatDate_(startDate) + ' إلى ' + prFormatDate_(endDate),
    days: days,
    dayCount: dayCount,
    pointsTotal: pointsTotal,
    target: target,
    metrics: metrics,
    grade: prGrade_(metrics.overall),
    positives: feedback.positives,
    improvements: feedback.improvements,
    teacherNote: feedback.note,
  };
}

function prBuildReportSheet_(ss, data) {
  const safeName = prSafeSheetName_('تقرير ولي الأمر - ' + data.studentName + ' - أ' + data.weekNumber);
  const old = ss.getSheetByName(safeName);
  if (old) ss.deleteSheet(old);

  const sheet = ss.insertSheet(safeName);
  sheet.setRightToLeft(true);
  sheet.setHiddenGridlines(true);
  sheet.setTabColor('#16968F');

  // نحتفظ فقط بالمساحة المستخدمة في التقرير.
  if (sheet.getMaxColumns() > 10) sheet.deleteColumns(11, sheet.getMaxColumns() - 10);
  if (sheet.getMaxRows() > 46) sheet.deleteRows(47, sheet.getMaxRows() - 46);

  const C = {
    teal: '#16968F',
    tealDark: '#0F7772',
    tealLight: '#E8F5F3',
    cream: '#FBF7F0',
    beige: '#D6BE99',
    beigeLight: '#F4EADB',
    gold: '#D4AE65',
    text: '#263D42',
    muted: '#64777A',
    white: '#FFFFFF',
    green: '#2D8A65',
    red: '#C65343',
    border: '#E4D7C3',
  };

  sheet.getRange('A1:J46').setBackground(C.cream).setFontFamily('Tajawal').setFontColor(C.text);
  for (let c = 1; c <= 10; c++) sheet.setColumnWidth(c, 78);

  [1,2,3].forEach(function(r) { sheet.setRowHeight(r, 34); });
  sheet.setRowHeight(4, 10);
  [5,6,7].forEach(function(r) { sheet.setRowHeight(r, 30); });
  sheet.setRowHeight(8, 12);
  [9,10,11,12,13].forEach(function(r) { sheet.setRowHeight(r, 30); });
  sheet.setRowHeight(14, 12);
  [15,16,17,18].forEach(function(r) { sheet.setRowHeight(r, 27); });
  sheet.setRowHeight(19, 10);
  sheet.setRowHeight(20, 28);

  // زخرفة علوية.
  sheet.getRange('A1:J1').setBackground(C.tealDark);
  sheet.getRange('A2:B3').setBackground(C.beigeLight);
  sheet.getRange('I2:J3').setBackground(C.tealLight);

  // الشعار.
  try {
    const logoBlob = Utilities.newBlob(Utilities.base64Decode(PR_LOGO_PNG_BASE64), 'image/png', 'rabee-logo.png');
    const logo = sheet.insertImage(logoBlob, 8, 1);
    logo.setWidth(125).setHeight(74).setAltTextTitle('ربيع القلوب');
  } catch (logoErr) {
    Logger.log('تعذر إدراج الشعار: ' + logoErr.message);
  }

  sheet.getRange('C1:H2').merge().setValue('التقرير الأسبوعي للطالب')
    .setFontSize(24).setFontWeight('bold').setFontColor(C.tealDark)
    .setHorizontalAlignment('center').setVerticalAlignment('middle');
  sheet.getRange('C3:H3').merge().setValue(data.weekLabel + '  •  ' + data.dateRange)
    .setFontSize(11).setFontColor(C.muted).setHorizontalAlignment('center');

  // بطاقات بيانات الطالب.
  prCard_(sheet, 'A5:C7', 'اسم الطالب', data.studentName, C);
  prCard_(sheet, 'D5:F7', 'المعلم', data.teacherName, C);
  prCard_(sheet, 'G5:J7', 'الحلقة', data.teamName + '  •  ' + data.weekLabel, C);

  // النتيجة الإجمالية.
  prCard_(sheet, 'A9:C13', 'التقدير', data.grade, C, true);
  sheet.getRange('D9:G9').merge().setValue('النتيجة الإجمالية')
    .setBackground(C.tealDark).setFontColor(C.white).setFontWeight('bold')
    .setHorizontalAlignment('center').setVerticalAlignment('middle');
  sheet.getRange('D10:G12').merge().setValue(data.pointsTotal + ' من ' + data.target + '\n' + data.metrics.overall + '%')
    .setBackground(C.white).setFontColor(C.tealDark).setFontSize(22).setFontWeight('bold')
    .setWrap(true).setHorizontalAlignment('center').setVerticalAlignment('middle');
  sheet.getRange('D13:G13').merge().setValue('مجموع نقاط الطالب خلال الأسبوع')
    .setBackground(C.beigeLight).setFontColor(C.muted).setFontSize(10).setHorizontalAlignment('center');
  prOutline_(sheet.getRange('D9:G13'), C.border);

  sheet.getRange('H9:J13').merge().setValue(prEncouragement_(data.metrics.overall))
    .setBackground(C.white).setFontSize(12).setFontWeight('bold').setWrap(true)
    .setHorizontalAlignment('center').setVerticalAlignment('middle');
  prOutline_(sheet.getRange('H9:J13'), C.border);

  // مؤشرات الأداء الخمسة.
  sheet.getRange('A15:J15').merge().setValue('ملخص الأداء')
    .setFontSize(15).setFontWeight('bold').setFontColor(C.tealDark)
    .setHorizontalAlignment('center');
  prMetric_(sheet, 'A16:B18', 'الحضور', data.metrics.attendance, C);
  prMetric_(sheet, 'C16:D18', 'الحفظ', data.metrics.hifz, C);
  prMetric_(sheet, 'E16:F18', 'المراجعة', data.metrics.review, C);
  prMetric_(sheet, 'G16:H18', 'إحضار الحقيبة', data.metrics.bag, C);
  prMetric_(sheet, 'I16:J18', 'الاستماع', data.metrics.listening, C);

  // جدول الأداء اليومي.
  sheet.getRange('A20:J20').merge().setValue('تفصيل الأداء اليومي')
    .setFontSize(15).setFontWeight('bold').setFontColor(C.tealDark)
    .setHorizontalAlignment('center');

  const headerRow = 21;
  const headers = ['اليوم', 'الحضور', 'الحفظ', 'المراجعة', 'الحقيبة', 'الاستماع', 'النقاط'];
  const headerRanges = ['A21:B21','C21:C21','D21:E21','F21:G21','H21:H21','I21:I21','J21:J21'];
  headers.forEach(function(label, idx) {
    sheet.getRange(headerRanges[idx]).merge().setValue(label)
      .setBackground(C.tealDark).setFontColor(C.white).setFontWeight('bold')
      .setHorizontalAlignment('center').setVerticalAlignment('middle');
  });

  data.days.forEach(function(day, index) {
    const row = headerRow + 1 + index;
    sheet.setRowHeight(row, 34);
    sheet.getRange(row, 1, 1, 10).setBackground(index % 2 === 0 ? C.white : C.tealLight);
    sheet.getRange(row, 1, 1, 2).merge().setValue(day.dayName + '\n' + day.date)
      .setFontWeight('bold').setWrap(true).setHorizontalAlignment('center').setVerticalAlignment('middle');
    sheet.getRange(row, 3).setValue(day.hudur).setFontColor(day.hudur === 'حاضر' ? C.green : (day.hudur === 'غائب' ? C.red : C.muted));
    sheet.getRange(row, 4, 1, 2).merge().setValue(prEvaluationText_(day.hifzScore));
    sheet.getRange(row, 6, 1, 2).merge().setValue(prEvaluationText_(day.muraScore));
    sheet.getRange(row, 8).setValue(day.haqiba).setFontColor(day.haqiba === 'نعم' ? C.green : C.red);
    sheet.getRange(row, 9).setValue(day.istima).setFontColor(day.istima === 'نعم' ? C.green : C.red);
    sheet.getRange(row, 10).setValue(day.total + ' / 100').setFontWeight('bold').setFontColor(C.tealDark);
    sheet.getRange(row, 3, 1, 8).setHorizontalAlignment('center').setVerticalAlignment('middle');
  });

  const lastDayRow = 21 + data.days.length;
  sheet.getRange(headerRow, 1, data.days.length + 1, 10).setBorder(true,true,true,true,true,true,C.border,SpreadsheetApp.BorderStyle.SOLID);

  // الحفظ والمراجعة خلال الأسبوع.
  const studyStart = lastDayRow + 2;
  sheet.getRange(studyStart, 1, 1, 10).merge().setValue('الحفظ والمراجعة هذا الأسبوع')
    .setFontSize(14).setFontWeight('bold').setFontColor(C.tealDark).setHorizontalAlignment('center');
  const assignments = prCollectAssignments_(data.days);
  sheet.getRange(studyStart + 1, 1, 2, 5).merge().setValue('الحفظ\n' + assignments.hifz)
    .setBackground(C.white).setWrap(true).setHorizontalAlignment('center').setVerticalAlignment('middle');
  sheet.getRange(studyStart + 1, 6, 2, 5).merge().setValue('المراجعة\n' + assignments.review)
    .setBackground(C.white).setWrap(true).setHorizontalAlignment('center').setVerticalAlignment('middle');
  prOutline_(sheet.getRange(studyStart + 1, 1, 2, 5), C.border);
  prOutline_(sheet.getRange(studyStart + 1, 6, 2, 5), C.border);

  // نقاط التميز والمتابعة.
  const feedbackRow = studyStart + 4;
  sheet.getRange(feedbackRow, 1, 1, 5).merge().setValue('نقاط التميز')
    .setBackground(C.teal).setFontColor(C.white).setFontWeight('bold').setHorizontalAlignment('center');
  sheet.getRange(feedbackRow, 6, 1, 5).merge().setValue('ما يحتاج متابعة')
    .setBackground(C.beige).setFontColor(C.white).setFontWeight('bold').setHorizontalAlignment('center');
  sheet.getRange(feedbackRow + 1, 1, 3, 5).merge().setValue('• ' + data.positives.join('\n• '))
    .setBackground(C.white).setWrap(true).setVerticalAlignment('top').setHorizontalAlignment('right');
  sheet.getRange(feedbackRow + 1, 6, 3, 5).merge().setValue('• ' + data.improvements.join('\n• '))
    .setBackground(C.white).setWrap(true).setVerticalAlignment('top').setHorizontalAlignment('right');
  prOutline_(sheet.getRange(feedbackRow, 1, 4, 5), C.border);
  prOutline_(sheet.getRange(feedbackRow, 6, 4, 5), C.border);

  // ملاحظة المعلم.
  const noteRow = feedbackRow + 5;
  sheet.getRange(noteRow, 1, 1, 10).merge().setValue('ملاحظة المعلم لولي الأمر')
    .setFontSize(14).setFontWeight('bold').setFontColor(C.tealDark).setHorizontalAlignment('center');
  sheet.getRange(noteRow + 1, 1, 3, 10).merge().setValue(data.teacherNote)
    .setBackground(C.white).setWrap(true).setFontSize(11)
    .setHorizontalAlignment('right').setVerticalAlignment('middle');
  prOutline_(sheet.getRange(noteRow + 1, 1, 3, 10), C.border);

  const footerRow = noteRow + 5;
  if (footerRow <= 46) {
    sheet.getRange(footerRow, 1, 1, 10).merge().setValue('ربيع القلوب — بناء جيل قرآني عامر بالإيمان')
      .setBackground(C.tealDark).setFontColor(C.white).setFontWeight('bold').setHorizontalAlignment('center');
  }

  sheet.getRange('A1:J46').setVerticalAlignment('middle');
  return sheet;
}

function prExportReportSheetAsPdf_(ss, sheet, data) {
  const folder = prGetOrCreateReportFolder_(data);
  const fileName = prSafeFileName_('التقرير الأسبوعي - ' + data.studentName + ' - ' + data.teamName + ' - الأسبوع ' + data.weekNumber + '.pdf');
  const range = 'A1:J46';
  const url = 'https://docs.google.com/spreadsheets/d/' + ss.getId() + '/export' +
    '?format=pdf' +
    '&size=A4' +
    '&portrait=true' +
    '&fitw=true' +
    '&sheetnames=false' +
    '&printtitle=false' +
    '&pagenumbers=false' +
    '&gridlines=false' +
    '&fzr=false' +
    '&top_margin=0.25' +
    '&bottom_margin=0.25' +
    '&left_margin=0.20' +
    '&right_margin=0.20' +
    '&gid=' + sheet.getSheetId() +
    '&range=' + encodeURIComponent(range);

  const response = UrlFetchApp.fetch(url, {
    headers: { Authorization: 'Bearer ' + ScriptApp.getOAuthToken() },
    muteHttpExceptions: true,
  });

  if (response.getResponseCode() !== 200) {
    throw new Error('فشل تصدير PDF. رمز الخطأ: ' + response.getResponseCode() + '\n' + response.getContentText());
  }

  const existing = folder.getFilesByName(fileName);
  while (existing.hasNext()) existing.next().setTrashed(true);
  return folder.createFile(response.getBlob().setName(fileName));
}

function prGetOrCreateReportFolder_(data) {
  const root = prGetOrCreateFolder_(DriveApp.getRootFolder(), PR_REPORTS_FOLDER_NAME);
  const week = prGetOrCreateFolder_(root, 'الأسبوع ' + data.weekNumber);
  return prGetOrCreateFolder_(week, data.teamName);
}

function prGetOrCreateFolder_(parent, name) {
  const found = parent.getFoldersByName(name);
  return found.hasNext() ? found.next() : parent.createFolder(name);
}

function prCard_(sheet, a1, label, value, C, big) {
  const range = sheet.getRange(a1);
  range.merge().setValue(label + '\n' + value)
    .setBackground(C.white).setWrap(true).setHorizontalAlignment('center').setVerticalAlignment('middle')
    .setFontColor(C.text).setFontSize(big ? 16 : 12).setFontWeight('bold');
  prOutline_(range, C.border);
}

function prMetric_(sheet, a1, label, value, C) {
  const range = sheet.getRange(a1);
  const tone = value >= 80 ? C.teal : (value >= 60 ? C.gold : C.red);
  range.merge().setValue(label + '\n' + value + '%')
    .setBackground(C.white).setWrap(true).setHorizontalAlignment('center').setVerticalAlignment('middle')
    .setFontSize(12).setFontWeight('bold').setFontColor(tone);
  prOutline_(range, C.border);
}

function prOutline_(range, color) {
  range.setBorder(true, true, true, true, false, false, color, SpreadsheetApp.BorderStyle.SOLID);
}

function prCollectAssignments_(days) {
  const hifz = [];
  const review = [];
  days.forEach(function(day) {
    const h = prAssignmentText_(day.hifzFrom, day.hifzTo);
    const r = prAssignmentText_(day.muraFrom, day.muraTo);
    if (h && hifz.indexOf(h) === -1) hifz.push(h);
    if (r && review.indexOf(r) === -1) review.push(r);
  });
  return {
    hifz: hifz.length ? hifz.join('، ') : 'لم يُسجل مقرر حفظ خلال هذا الأسبوع',
    review: review.length ? review.join('، ') : 'لم يُسجل مقرر مراجعة خلال هذا الأسبوع',
  };
}

function prAssignmentText_(from, to) {
  from = String(from || '').trim();
  to = String(to || '').trim();
  if (!from && !to) return '';
  if (from && to) return 'من ' + from + ' إلى ' + to;
  return from || to;
}

function prBuildFeedback_(metrics) {
  const items = [
    { key: 'attendance', label: 'الالتزام بالحضور', value: metrics.attendance },
    { key: 'hifz', label: 'أداء الحفظ', value: metrics.hifz },
    { key: 'review', label: 'المراجعة اليومية', value: metrics.review },
    { key: 'bag', label: 'إحضار الحقيبة', value: metrics.bag },
    { key: 'listening', label: 'الاستماع للمقرر', value: metrics.listening },
  ];
  const positives = items.filter(function(x) { return x.value >= 80; })
    .sort(function(a,b) { return b.value - a.value; })
    .slice(0,3)
    .map(function(x) { return x.label + ' بمستوى ' + x.value + '%'; });
  const improvements = items.filter(function(x) { return x.value < 80; })
    .sort(function(a,b) { return a.value - b.value; })
    .slice(0,3)
    .map(function(x) { return 'رفع مستوى ' + x.label + ' عن طريق المتابعة اليومية'; });

  if (!positives.length) positives.push('الاستمرار في المحاولة والانضباط حتى تتحسن النتائج');
  if (!improvements.length) improvements.push('المحافظة على هذا المستوى المتميز طوال الأسابيع القادمة');

  let note;
  if (metrics.overall >= 90) {
    note = 'نبارك لكم تميز ابنكم هذا الأسبوع. ظهر عليه الالتزام والاجتهاد، ونوصي بالاستمرار على هذا المستوى المبارك.';
  } else if (metrics.overall >= 75) {
    note = 'أظهر الطالب تقدماً جيداً خلال هذا الأسبوع، ونأمل منكم دعمه على الاستمرار في المراجعة والاستماع للمقرر يومياً.';
  } else {
    note = 'يحتاج الطالب إلى متابعة يومية أكثر في الحفظ والمراجعة، ونثق أن تعاون البيت مع الحلقة سيحدث تحسناً واضحاً بإذن الله.';
  }

  return { positives: positives, improvements: improvements, note: note };
}

function prGrade_(pct) {
  if (pct >= 90) return 'متميز';
  if (pct >= 80) return 'ممتاز';
  if (pct >= 70) return 'جيد جدًا';
  if (pct >= 60) return 'جيد';
  return 'يحتاج متابعة';
}

function prEncouragement_(pct) {
  if (pct >= 90) return 'بارك الله في جهودك المتميزة\nاستمر نحو المزيد من الإنجاز';
  if (pct >= 80) return 'أداء ممتاز وتقدم جميل\nواصل الاجتهاد والمحافظة';
  if (pct >= 70) return 'تقدم جيد هذا الأسبوع\nخطوات بسيطة تصنع فرقًا كبيرًا';
  return 'نثق بقدرتك على التحسن\nالمتابعة اليومية طريق التميز';
}

function prPct_(value, max) {
  if (!max || max <= 0) return 0;
  return Math.max(0, Math.min(100, Math.round((Number(value || 0) / max) * 100)));
}

function prNumber_(value) {
  const n = Number(value);
  return Number.isFinite(n) ? n : 0;
}

function prScoreNumber_(value) {
  if (value === null || value === undefined || value === '') return 0;
  const text = String(value).trim();
  if (text === 'لم يسمع' || text === 'غائب') return 0;
  return prNumber_(value);
}

// يحوّل درجة الحفظ أو المراجعة إلى تقدير لفظي داخل تقرير ولي الأمر فقط.
function prEvaluationText_(value) {
  const score = prNumber_(value);
  if (score === 30) return 'ممتاز';
  if (score === 25) return 'جيد جدًا';
  if (score === 20) return 'جيد';
  return score + ' / 30';
}

function prAttendanceText_(value) {
  if (value === true || value === 1 || String(value).trim() === 'حاضر') return 'حاضر';
  if (value === false || value === 0 || String(value).trim() === 'غائب') return 'غائب';
  return String(value || '').trim();
}

function prYesNoText_(value) {
  if (value === true || value === 1 || String(value).trim() === 'نعم') return 'نعم';
  if (value === false || value === 0 || String(value).trim() === 'لا') return 'لا';
  return String(value || '').trim();
}

function prGetWeekDates_(courseStart, weekNumber) {
  if (typeof getUnifiedWeekDates_ === 'function') {
    return getUnifiedWeekDates_(courseStart, weekNumber);
  }
  const start = new Date(courseStart.getFullYear(), courseStart.getMonth(), courseStart.getDate() + (weekNumber - 1) * 7);
  const dates = [0,1,2,3].map(function(offset) { return new Date(start.getFullYear(), start.getMonth(), start.getDate() + offset); });
  if (weekNumber === 2) dates.push(prParseDate_('2026-07-11'));
  return dates.filter(Boolean).sort(function(a,b) { return a.getTime() - b.getTime(); });
}

function prNormalizeTeamId_(value) {
  if (typeof normalizeTeamId === 'function') return normalizeTeamId(value);
  const text = prNormalizeName_(value);
  if (text === 'blue' || text.indexOf('اول') !== -1) return 'blue';
  if (text === 'red' || text.indexOf('ثاني') !== -1 || text.indexOf('ثانية') !== -1) return 'red';
  if (text === 'green' || text.indexOf('ثالث') !== -1) return 'green';
  if (text === 'purple' || text.indexOf('رابع') !== -1) return 'purple';
  return '';
}

function prTeamName_(teamId) {
  return { blue: 'حلقة أولى', red: 'حلقة ثاني', green: 'حلقة ثالث', purple: 'حلقة رابع' }[teamId] || teamId;
}

function prNormalizeName_(value) {
  return String(value || '')
    .replace(/[ًٌٍَُِّْـ]/g, '')
    .replace(/[إأآ]/g, 'ا')
    .replace(/ى/g, 'ي')
    .replace(/ة/g, 'ه')
    .replace(/\s+/g, ' ')
    .trim()
    .toLowerCase();
}

function prDateCellToString_(value) {
  if (value instanceof Date && !isNaN(value.getTime())) return prFormatDate_(value);
  if (typeof dateValueToString === 'function') return dateValueToString(value);
  return String(value || '').trim();
}

function prNormalizeDate_(value) {
  if (typeof normalizeDate === 'function') return normalizeDate(value);
  const d = prParseDate_(value);
  return d ? prFormatDate_(d) : '';
}

function prParseDate_(value) {
  if (value instanceof Date && !isNaN(value.getTime())) return new Date(value.getFullYear(), value.getMonth(), value.getDate());
  const text = String(value || '').trim();
  if (!text) return null;
  let m = text.match(/^(\d{4})[\/-](\d{1,2})[\/-](\d{1,2})$/);
  if (m) return new Date(Number(m[1]), Number(m[2]) - 1, Number(m[3]));
  m = text.match(/^(\d{1,2})[\/-](\d{1,2})[\/-](\d{4})$/);
  if (m) {
    const a = Number(m[1]), b = Number(m[2]), y = Number(m[3]);
    // ملف المشروع يستخدم تاريخاً أمريكياً في بعض المواضع مثل 7/5/2026.
    return new Date(y, a - 1, b);
  }
  const d = new Date(text);
  return isNaN(d.getTime()) ? null : new Date(d.getFullYear(), d.getMonth(), d.getDate());
}

function prFormatDate_(dateObj) {
  if (typeof formatDate === 'function') return formatDate(dateObj);
  return Utilities.formatDate(dateObj, APP_TIMEZONE || 'Asia/Riyadh', 'yyyy-MM-dd');
}

function prDayName_(dateObj) {
  const names = (typeof DAY_NAMES_AR !== 'undefined' && DAY_NAMES_AR) || ['الأحد','الإثنين','الثلاثاء','الأربعاء','الخميس','الجمعة','السبت'];
  return names[dateObj.getDay()];
}

function prArabicOrdinal_(weekNumber) {
  return {1:'الأول',2:'الثاني',3:'الثالث',4:'الرابع',5:'الخامس',6:'السادس'}[weekNumber] || String(weekNumber);
}

function prSafeSheetName_(name) {
  return String(name || 'تقرير').replace(/[\/?*\[\]:]/g, '-').slice(0, 95);
}

function prSafeFileName_(name) {
  return String(name || 'تقرير.pdf').replace(/[\/:*?"<>|]/g, '-');
}
