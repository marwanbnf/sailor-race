/**
 * تقرير ولي الأمر — نسخة ويب/PDF بدون إنشاء أي Sheet جديد.
 *
 * الاستخدام:
 * 1) أضف هذا الملف إلى مشروع Apps Script باسم ParentReportWeb.gs.
 * 2) أضف ملف HTML باسم ParentReportTemplate والصق الملف المرفق.
 * 3) داخل doGet(e) الموجود في Code.gs أضف:
 *      if (action === 'parentReport') return showParentReportWeb_(e);
 * 4) انشر إصداراً جديداً من Web App.
 * 5) شغّل getAliWeekOneParentReportUrl ثم افتح الرابط من Execution log.
 */

const PWR_DEFAULT_STUDENT = 'علي عامر';
const PWR_DEFAULT_TEAM_ID = 'purple';
const PWR_DEFAULT_WEEK = 1;
const PWR_DEFAULT_TEACHER = '';
const PWR_TIMEZONE = 'Asia/Riyadh';
const PWR_LOGO_DATA_URL = 'data:image/png;base64,';

function showParentReportWeb_(e) {
  const p = (e && e.parameter) || {};
  const studentName = String(p.studentName || PWR_DEFAULT_STUDENT).trim();
  const teamId = pwrNormalizeTeamId_(p.teamId || PWR_DEFAULT_TEAM_ID);
  const weekNumber = Math.max(1, Math.min((typeof COURSE_WEEKS_COUNT !== 'undefined') ? COURSE_WEEKS_COUNT : 16, Number(p.week || p.weekNumber || PWR_DEFAULT_WEEK)));
  const teacherName = String(p.teacherName || PWR_DEFAULT_TEACHER).trim();

  const report = pwrBuildParentReportData_(studentName, teamId, weekNumber, teacherName);
  const template = HtmlService.createTemplateFromFile('ParentReportTemplate');
  template.reportJson = JSON.stringify(report);
  template.logoDataUrl = PWR_LOGO_DATA_URL;

  // رابط الرجوع إلى لوحة تقارير أولياء الأمور.
  // يجب تعريفه قبل evaluate لأن القالب يستخدم المتغير dashboardUrl.
  const dashboardBaseUrl = (typeof prdGetPublicWebAppUrl_ === 'function')
    ? prdGetPublicWebAppUrl_()
    : String(ScriptApp.getService().getUrl() || '').trim().replace(/\/dev(?:\?.*)?$/, '/exec');

  template.dashboardUrl = dashboardBaseUrl
    ? dashboardBaseUrl + '?' + [
        'action=parentReports',
        'teamId=' + encodeURIComponent(teamId),
        'week=' + encodeURIComponent(weekNumber),
        'teacherName=' + encodeURIComponent(teacherName)
      ].join('&')
    : '';

  return template.evaluate()
    .setTitle('التقرير الأسبوعي - ' + studentName)
    .setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL)
    .addMetaTag('viewport', 'width=device-width, initial-scale=1');
}

/** رابط تجربة الأسبوع الأول لعلي عامر — لا ينشئ شيتات. */
function getAliWeekOneParentReportUrl() {
  const base = ScriptApp.getService().getUrl();
  if (!base) {
    throw new Error('انشر المشروع أولاً كتطبيق ويب، ثم شغّل الدالة مرة أخرى.');
  }
  const query = [
    'action=parentReport',
    'studentName=' + encodeURIComponent(PWR_DEFAULT_STUDENT),
    'teamId=' + encodeURIComponent(PWR_DEFAULT_TEAM_ID),
    'week=1',
    'teacherName=' + encodeURIComponent(PWR_DEFAULT_TEACHER)
  ].join('&');
  const url = base + '?' + query;
  Logger.log('رابط تقرير الأسبوع الأول: ' + url);
  return url;
}

/** اختياري: يحذف فقط أوراق التجربة القديمة التي أنشأها السكربت السابق. */
function deleteOldParentReportSheets_Optional() {
  const ss = SpreadsheetApp.openById(SPREADSHEET_ID);
  const candidates = ss.getSheets().filter(function(sheet) {
    return /^تقرير ولي الأمر\s*-/.test(sheet.getName());
  });
  candidates.forEach(function(sheet) {
    if (ss.getSheets().length > 1) ss.deleteSheet(sheet);
  });
  SpreadsheetApp.flush();
  return 'تم حذف ' + candidates.length + ' ورقة تقرير تجريبية قديمة';
}

function pwrBuildParentReportData_(studentName, teamId, weekNumber, teacherName) {
  if (!studentName) throw new Error('اسم الطالب مطلوب');
  if (!teamId) throw new Error('الحلقة غير صحيحة');

  const ss = SpreadsheetApp.openById(SPREADSHEET_ID);
  const logSheet = ss.getSheetByName(typeof SHEET_LOG !== 'undefined' ? SHEET_LOG : 'البيانات');
  if (!logSheet) throw new Error('لم يتم العثور على ورقة البيانات');

  const courseStart = pwrParseDate_(typeof COURSE_START_DATE !== 'undefined' ? COURSE_START_DATE : '2026-07-05');
  if (!courseStart) throw new Error('تاريخ بداية الدورة غير صحيح');

  const weekDates = pwrGetWeekDates_(courseStart, weekNumber);

  // المصدر الأساسي الآن هو تقرير الحلقة نفسه، حتى يظهر أي تعديل يدوي فوراً
  // في تقرير ولي الأمر. ورقة "البيانات" تستخدم فقط كاحتياط إذا تعذر قراءة التقرير.
  const logByDate = pwrReadStudentWeekFromLog_(logSheet, studentName, teamId);
  const unified = pwrReadStudentWeekFromUnifiedReport_(ss, studentName, teamId, weekNumber);
  const byDate = {};

  Object.keys(logByDate).forEach(function(key) {
    byDate[key] = logByDate[key];
  });
  if (unified.found) {
    Object.keys(unified.byDate).forEach(function(key) {
      byDate[key] = unified.byDate[key];
    });
  }

  const days = weekDates.map(function(dateObj) {
    const key = pwrDateKey_(dateObj);
    const r = byDate[key] || {};
    return {
      date: key,
      displayDate: Utilities.formatDate(dateObj, PWR_TIMEZONE, 'dd/MM/yyyy'),
      dayName: pwrDayName_(dateObj),
      hudur: r.hudur || '—',
      hifzFrom: r.hifzFrom || '',
      hifzTo: r.hifzTo || '',
      hifzScore: pwrNumber_(r.hifzScore),
      muraFrom: r.muraFrom || '',
      muraTo: r.muraTo || '',
      muraScore: pwrNumber_(r.muraScore),
      haqiba: r.haqiba || '—',
      istima: r.istima || '—',
      total: pwrNumber_(r.total),
      note: r.note || '',
      hasRecord: r.hasRecord === true || pwrHasMeaningfulDayData_(r)
    };
  });

  const dayCount = days.length;
  const dailyPointsTotal = days.reduce(function(sum, d) { return sum + d.total; }, 0);
  const dailyPresentCount = days.filter(function(d) { return d.hudur === 'حاضر'; }).length;
  const dailyHifzTotal = days.reduce(function(sum, d) { return sum + d.hifzScore; }, 0);
  const dailyMuraTotal = days.reduce(function(sum, d) { return sum + d.muraScore; }, 0);
  const dailyBagCount = days.filter(function(d) { return d.haqiba === 'نعم'; }).length;
  const dailyListeningCount = days.filter(function(d) { return d.istima === 'نعم'; }).length;
  const dailyTarget = dayCount * 100;

  // إذا وجد صف الأسبوع داخل تقرير الحلقة، نستخدم مجاميعه كذلك.
  // بهذا تنعكس تعديلات صف الأسبوع نفسه، وليس صفوف الأيام فقط.
  const summary = unified.weekSummary || {};
  const pointsTotal = unified.found && summary.hasValues ? pwrNumber_(summary.total) : dailyPointsTotal;
  const target = unified.found && summary.hasValues && pwrNumber_(summary.target) > 0
    ? pwrNumber_(summary.target)
    : dailyTarget;
  const presentCount = unified.found && summary.hasValues
    ? pwrNumber_(summary.present)
    : dailyPresentCount;
  const hifzTotal = unified.found && summary.hasValues
    ? pwrNumber_(summary.hifzScore)
    : dailyHifzTotal;
  const muraTotal = unified.found && summary.hasValues
    ? pwrNumber_(summary.muraScore)
    : dailyMuraTotal;
  const bagCount = unified.found && summary.hasValues
    ? pwrNumber_(summary.haqibaCount)
    : dailyBagCount;
  const listeningCount = unified.found && summary.hasValues
    ? pwrNumber_(summary.istimaCount)
    : dailyListeningCount;

  const metrics = {
    attendance: pwrPct_(presentCount, dayCount),
    hifz: pwrPct_(hifzTotal, dayCount * 30),
    review: pwrPct_(muraTotal, dayCount * 30),
    bag: pwrPct_(bagCount, dayCount),
    listening: pwrPct_(listeningCount, dayCount),
    overall: pwrPct_(pointsTotal, target)
  };

  const feedback = pwrFeedback_(metrics, days);
  const assignment = pwrAssignments_(days);
  const teamName = (typeof TEAM_SHEETS !== 'undefined' && TEAM_SHEETS[teamId]) || pwrTeamName_(teamId);

  return {
    studentName: studentName,
    teacherName: teacherName,
    teamId: teamId,
    teamName: teamName,
    weekNumber: weekNumber,
    weekTitle: 'الأسبوع ' + pwrOrdinal_(weekNumber),
    dateRange: 'من ' + Utilities.formatDate(weekDates[0], PWR_TIMEZONE, 'dd/MM/yyyy') + ' إلى ' + Utilities.formatDate(weekDates[weekDates.length - 1], PWR_TIMEZONE, 'dd/MM/yyyy'),
    pointsTotal: pointsTotal,
    target: target,
    metrics: metrics,
    grade: pwrGrade_(metrics.overall),
    days: days,
    assignment: assignment,
    positives: feedback.positives,
    improvements: feedback.improvements,
    teacherNote: feedback.note,
    hasAnyRecord: days.some(function(d) { return d.hasRecord; }),
    dataSource: unified.found ? 'تقرير الحلقة' : 'ورقة البيانات'
  };
}

function pwrReadStudentWeekFromLog_(logSheet, studentName, teamId) {
  const byDate = {};
  const targetName = pwrNormalizeName_(studentName);
  const lastRow = logSheet.getLastRow();

  if (lastRow < 2) return byDate;

  const rows = logSheet.getRange(2, 1, lastRow - 1, 14).getValues();
  rows.forEach(function(row) {
    const rowName = pwrNormalizeName_(row[1]);
    if (!rowName || rowName !== targetName) return;

    const rowTeam = pwrNormalizeTeamId_(row[13]);
    if (rowTeam && rowTeam !== teamId) return;

    const dateKey = pwrNormalizeDate_(row[0]);
    if (!dateKey) return;

    byDate[dateKey] = {
      hudur: pwrAttendance_(row[2]),
      hifzFrom: String(row[3] || '').trim(),
      hifzTo: String(row[4] || '').trim(),
      hifzScore: pwrScore_(row[5]),
      muraFrom: String(row[6] || '').trim(),
      muraTo: String(row[7] || '').trim(),
      muraScore: pwrScore_(row[8]),
      haqiba: pwrYesNo_(row[9]),
      istima: pwrYesNo_(row[10]),
      total: pwrNumber_(row[11]),
      note: String(row[12] || '').trim(),
      hasRecord: true
    };
  });

  return byDate;
}

function pwrReadStudentWeekFromUnifiedReport_(ss, studentName, teamId, weekNumber) {
  const result = {
    found: false,
    byDate: {},
    weekSummary: { hasValues: false }
  };

  const teamName = (typeof TEAM_SHEETS !== 'undefined' && TEAM_SHEETS[teamId]) || pwrTeamName_(teamId);
  const prefix = (typeof UNIFIED_PREFIX !== 'undefined' && UNIFIED_PREFIX) ? UNIFIED_PREFIX : 'تقرير ';
  const sheet = ss.getSheetByName(prefix + teamName);
  if (!sheet || sheet.getLastRow() < 3) return result;

  const lastRow = sheet.getLastRow();
  const columnCount = Math.min(13, Math.max(sheet.getLastColumn(), 13));
  const values = sheet.getRange(3, 1, lastRow - 2, columnCount).getValues();
  const display = sheet.getRange(3, 1, lastRow - 2, columnCount).getDisplayValues();
  const targetName = pwrNormalizeName_(studentName);

  let studentIndex = -1;
  for (let i = 0; i < display.length; i++) {
    if (pwrNormalizeName_(display[i][0]) === targetName) {
      studentIndex = i;
      break;
    }
  }
  if (studentIndex < 0) return result;

  let weekIndex = -1;
  for (let i = studentIndex + 1; i < display.length; i++) {
    const label = String(display[i][0] || '').trim();
    if (pwrIsUnifiedStudentRow_(display[i]) && i > studentIndex + 1) break;
    const parsedWeek = pwrExtractUnifiedWeekNumber_(label);
    if (parsedWeek === Number(weekNumber)) {
      weekIndex = i;
      break;
    }
  }
  if (weekIndex < 0) return result;

  result.found = true;
  const weekRowRaw = values[weekIndex];
  const weekRowDisplay = display[weekIndex];
  result.weekSummary = {
    hasValues: true,
    present: pwrExtractPresentCount_(weekRowDisplay[1]),
    hifzScore: pwrNumber_(weekRowRaw[4] !== '' ? weekRowRaw[4] : weekRowDisplay[4]),
    muraScore: pwrNumber_(weekRowRaw[7] !== '' ? weekRowRaw[7] : weekRowDisplay[7]),
    haqibaCount: pwrNumber_(weekRowRaw[8] !== '' ? weekRowRaw[8] : weekRowDisplay[8]),
    istimaCount: pwrNumber_(weekRowRaw[9] !== '' ? weekRowRaw[9] : weekRowDisplay[9]),
    total: pwrNumber_(weekRowRaw[10] !== '' ? weekRowRaw[10] : weekRowDisplay[10]),
    target: pwrNumber_(weekRowRaw[11] !== '' ? weekRowRaw[11] : weekRowDisplay[11])
  };

  for (let i = weekIndex + 1; i < display.length; i++) {
    const rowDisplay = display[i];
    const rowRaw = values[i];
    const label = String(rowDisplay[0] || '').trim();

    if (pwrExtractUnifiedWeekNumber_(label) > 0) break;
    if (pwrIsUnifiedStudentRow_(rowDisplay)) break;

    const dateKey = pwrExtractDateFromUnifiedLabel_(label);
    if (!dateKey) continue;

    const day = {
      hudur: pwrAttendance_(rowDisplay[1]),
      hifzFrom: String(rowDisplay[2] || '').trim(),
      hifzTo: String(rowDisplay[3] || '').trim(),
      hifzScore: pwrScore_(rowRaw[4] !== '' ? rowRaw[4] : rowDisplay[4]),
      muraFrom: String(rowDisplay[5] || '').trim(),
      muraTo: String(rowDisplay[6] || '').trim(),
      muraScore: pwrScore_(rowRaw[7] !== '' ? rowRaw[7] : rowDisplay[7]),
      haqiba: pwrYesNo_(rowDisplay[8]),
      istima: pwrYesNo_(rowDisplay[9]),
      total: pwrNumber_(rowRaw[10] !== '' ? rowRaw[10] : rowDisplay[10]),
      note: String(rowDisplay[12] || '').trim()
    };
    day.hasRecord = pwrHasMeaningfulDayData_(day);
    result.byDate[dateKey] = day;
  }

  return result;
}

function pwrIsUnifiedStudentRow_(row) {
  if (!row || !String(row[0] || '').trim()) return false;
  const label = String(row[0] || '').trim();
  if (pwrExtractUnifiedWeekNumber_(label) > 0) return false;
  if (pwrExtractDateFromUnifiedLabel_(label)) return false;
  for (let i = 1; i < row.length; i++) {
    if (String(row[i] == null ? '' : row[i]).trim() !== '') return false;
  }
  return true;
}

function pwrExtractUnifiedWeekNumber_(label) {
  const normalized = pwrToWesternDigits_(String(label || ''))
    .replace(/[\u200e\u200f\u061c]/g, '')
    .trim();
  const match = normalized.match(/^الأسبوع\s+(\d+)/);
  return match ? Number(match[1]) : 0;
}

function pwrExtractDateFromUnifiedLabel_(label) {
  const normalized = pwrToWesternDigits_(String(label || ''))
    .replace(/[\u200e\u200f\u061c]/g, '')
    .trim();
  const match = normalized.match(/(\d{4}[-\/]\d{1,2}[-\/]\d{1,2}|\d{1,2}\/\d{1,2}\/\d{4})/);
  return match ? pwrNormalizeDate_(match[1]) : '';
}

function pwrExtractPresentCount_(value) {
  const normalized = pwrToWesternDigits_(String(value || ''));
  const match = normalized.match(/(\d+)\s*يوم\s*حضور/);
  if (match) return Number(match[1]);
  const number = Number(normalized);
  return Number.isFinite(number) ? number : 0;
}

function pwrToWesternDigits_(value) {
  return String(value || '')
    .replace(/[٠١٢٣٤٥٦٧٨٩]/g, function(d) { return '٠١٢٣٤٥٦٧٨٩'.indexOf(d); })
    .replace(/[۰۱۲۳۴۵۶۷۸۹]/g, function(d) { return '۰۱۲۳۴۵۶۷۸۹'.indexOf(d); });
}

function pwrHasMeaningfulDayData_(row) {
  if (!row) return false;
  const note = String(row.note || '').trim();
  const meaningfulNote = note && note !== 'لم يتم تسجيل بيانات' && !pwrIsAutomaticAbsenceNote_(note);
  return row.hudur === 'حاضر' || row.hudur === 'غائب' ||
    pwrNumber_(row.hifzScore) > 0 || pwrNumber_(row.muraScore) > 0 ||
    row.haqiba === 'نعم' || row.haqiba === 'لا' ||
    row.istima === 'نعم' || row.istima === 'لا' ||
    pwrNumber_(row.total) > 0 || !!meaningfulNote ||
    !!String(row.hifzFrom || '').trim() || !!String(row.hifzTo || '').trim() ||
    !!String(row.muraFrom || '').trim() || !!String(row.muraTo || '').trim();
}

function pwrGetWeekDates_(courseStart, weekNumber) {
  // نستخدم نفس دالة بناء تواريخ التقرير الموحد إذا كانت موجودة في Code.gs،
  // حتى يتطابق تقرير ولي الأمر 100% مع أيام تقرير الحلقة (ومنها السبت التجريبي).
  if (typeof getUnifiedWeekDates_ === 'function') {
    const unifiedDates = getUnifiedWeekDates_(courseStart, weekNumber);
    if (Array.isArray(unifiedDates) && unifiedDates.length) {
      return unifiedDates.map(function(d) {
        return new Date(d.getFullYear(), d.getMonth(), d.getDate());
      });
    }
  }

  const weekStart = new Date(courseStart.getFullYear(), courseStart.getMonth(), courseStart.getDate() + ((weekNumber - 1) * 7));
  const days = [];
  const sessionDays = (typeof SESSION_DAYS !== 'undefined' && Array.isArray(SESSION_DAYS)) ? SESSION_DAYS : [0, 1, 2, 3];
  for (let i = 0; i < 7; i++) {
    const d = new Date(weekStart.getFullYear(), weekStart.getMonth(), weekStart.getDate() + i);
    if (sessionDays.indexOf(d.getDay()) !== -1) days.push(d);
  }
  return days;
}

function pwrAssignments_(days) {
  const hifz = days.filter(function(d) { return d.hifzFrom || d.hifzTo; });
  const mura = days.filter(function(d) { return d.muraFrom || d.muraTo; });
  return {
    hifz: hifz.length ? pwrRangeText_(hifz[0].hifzFrom, hifz[hifz.length - 1].hifzTo) : 'لم يسجل مقرر حفظ خلال هذا الأسبوع',
    review: mura.length ? pwrRangeText_(mura[0].muraFrom, mura[mura.length - 1].muraTo) : 'لم يسجل مقرر مراجعة خلال هذا الأسبوع'
  };
}

function pwrRangeText_(from, to) {
  from = String(from || '').trim();
  to = String(to || '').trim();

  // عند اختيار «لا يوجد حفظ» نعرضها مرة واحدة فقط،
  // بدل: من لا يوجد إلى لا يوجد.
  if (from === 'لا يوجد' || to === 'لا يوجد') return 'لا يوجد';

  if (from && to) return 'من ' + from + ' إلى ' + to;
  return from || to || '—';
}

function pwrFeedback_(m, days) {
  const positives = [];
  const improvements = [];
  if (m.attendance >= 90) positives.push('التزام ممتاز بالحضور والانضباط.');
  else improvements.push('الحرص على الانتظام في الحضور.');
  if (m.hifz >= 80) positives.push('تقدم واضح في الحفظ المقرر.');
  else improvements.push('زيادة المراجعة اليومية للحفظ.');
  if (m.review >= 80) positives.push('أداء جيد في تثبيت المراجعة.');
  else improvements.push('تخصيص وقت ثابت للمراجعة.');
  if (m.bag >= 90) positives.push('ملتزم بإحضار الحقيبة بشكل منتظم.');
  else improvements.push('الاهتمام بإحضار الحقيبة يومياً.');
  if (m.listening >= 80) positives.push('انتظام جيد في الاستماع للمقرر.');
  else improvements.push('الاستماع للمقرر قبل موعد الحلقة.');

  while (positives.length < 3) positives.push('نقدّر جهوده واستمراره في البرنامج.');
  while (improvements.length < 3) improvements.push('الاستمرار على المتابعة اليومية مع التشجيع.');

  // ملاحظة ولي الأمر تُؤخذ فقط من تسجيل يوم الأربعاء.
  // لا نعرض ملاحظة الغياب التلقائي، ولا نولّد ملاحظة بديلة تلقائياً.
  const wednesday = days.find(function(d) {
    return d.dayName === 'الأربعاء';
  });
  const wednesdayNote = String((wednesday && wednesday.note) || '').trim();
  const note = pwrIsAutomaticAbsenceNote_(wednesdayNote) ? '' : wednesdayNote;

  return { positives: positives.slice(0, 3), improvements: improvements.slice(0, 3), note: note };
}

function pwrIsAutomaticAbsenceNote_(note) {
  const normalized = String(note || '')
    .replace(/[\u200B-\u200D\uFEFF]/g, '')
    .replace(/\s+/g, ' ')
    .trim();
  return /غياب\s*تلقائ[يى]/.test(normalized);
}

function pwrGrade_(pct) {
  if (pct >= 90) return 'متميز';
  if (pct >= 80) return 'ممتاز';
  if (pct >= 70) return 'جيد جداً';
  if (pct >= 60) return 'جيد';
  return 'يحتاج متابعة';
}

function pwrPct_(value, max) {
  if (!max) return 0;
  return Math.max(0, Math.min(100, Math.round((Number(value || 0) / Number(max)) * 100)));
}

function pwrScore_(value) {
  const text = String(value == null ? '' : value).trim();
  if (!text || text === 'لم يسمع' || text === 'لم يسمّع' || text === 'absent') return 0;
  return pwrNumber_(text);
}

function pwrNumber_(value) {
  const n = Number(value);
  return Number.isFinite(n) ? n : 0;
}

function pwrAttendance_(value) {
  if (value === true) return 'حاضر';
  if (value === false) return 'غائب';
  const s = String(value || '').trim();
  if (s === 'حاضر' || s === 'غائب') return s;
  return s ? s : '—';
}

function pwrYesNo_(value) {
  if (value === true) return 'نعم';
  if (value === false) return 'لا';
  const s = String(value || '').trim();
  if (s === 'نعم' || s === 'لا') return s;
  return s ? s : '—';
}

function pwrNormalizeTeamId_(value) {
  const s = String(value || '').trim();
  if (['blue', 'red', 'green', 'purple'].indexOf(s) !== -1) return s;
  const n = pwrNormalizeName_(s);
  if (n.indexOf('اول') !== -1 || n === 'ازرق') return 'blue';
  if (n.indexOf('ثاني') !== -1 || n.indexOf('ثانيه') !== -1 || n === 'احمر') return 'red';
  if (n.indexOf('ثالث') !== -1 || n.indexOf('ثالثه') !== -1 || n === 'اخضر') return 'green';
  if (n.indexOf('رابع') !== -1 || n.indexOf('رابعه') !== -1 || n === 'بنفسجي') return 'purple';
  return '';
}

function pwrTeamName_(teamId) {
  return ({ blue: 'حلقة أولى', red: 'حلقة ثاني', green: 'حلقة ثالث', purple: 'حلقة رابع' })[teamId] || teamId;
}

function pwrNormalizeName_(value) {
  return String(value || '')
    .trim()
    .replace(/[\u064B-\u065F\u0670]/g, '')
    .replace(/ـ/g, '')
    .replace(/[أإآ]/g, 'ا')
    .replace(/ى/g, 'ي')
    .replace(/ة/g, 'ه')
    .replace(/\s+/g, ' ')
    .toLowerCase();
}

function pwrNormalizeDate_(value) {
  if (value instanceof Date && !isNaN(value.getTime())) return pwrDateKey_(value);
  const d = pwrParseDate_(value);
  return d ? pwrDateKey_(d) : '';
}

function pwrDateKey_(d) {
  return Utilities.formatDate(d, PWR_TIMEZONE, 'yyyy-MM-dd');
}

function pwrParseDate_(value) {
  if (value instanceof Date && !isNaN(value.getTime())) return new Date(value.getFullYear(), value.getMonth(), value.getDate());
  const s = String(value || '').trim();
  if (!s) return null;
  let m = s.match(/^(\d{4})[-\/]([0-1]?\d)[-\/]([0-3]?\d)$/);
  if (m) return new Date(Number(m[1]), Number(m[2]) - 1, Number(m[3]));
  m = s.match(/^([0-1]?\d)[-\/]([0-3]?\d)[-\/](\d{4})$/);
  if (m) return new Date(Number(m[3]), Number(m[1]) - 1, Number(m[2]));
  const d = new Date(s);
  return isNaN(d.getTime()) ? null : new Date(d.getFullYear(), d.getMonth(), d.getDate());
}

function pwrDayName_(d) {
  return ['الأحد', 'الإثنين', 'الثلاثاء', 'الأربعاء', 'الخميس', 'الجمعة', 'السبت'][d.getDay()];
}

function pwrOrdinal_(n) {
  return ({1:'الأول',2:'الثاني',3:'الثالث',4:'الرابع',5:'الخامس',6:'السادس',7:'السابع',8:'الثامن',9:'التاسع',10:'العاشر',11:'الحادي عشر',12:'الثاني عشر',13:'الثالث عشر',14:'الرابع عشر',15:'الخامس عشر',16:'السادس عشر'})[Number(n)] || String(n);
}
